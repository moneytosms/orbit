<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
    <TextView android:id="@+id/row_tick" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
        android:text="○" android:textSize="22sp" android:textColor="#777777" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#2A2723" />
        <TextView android:id="@+id/row_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
