---
import Landing from "../layouts/Landing.astro";
import { withBase } from "../lib/source";
---

<Landing title="Off orbit | Orbit" description="That page is not part of the Orbit site.">
  <style is:global>
    body { margin: 0; background: #fbfaf8; color: #2a2723; font: 400 1.0625rem/1.6 system-ui, sans-serif; }
    .lost { min-height: 100vh; display: grid; place-content: center; gap: 12px; padding: 24px; }
    .lost a { color: #a3441f; }
    @media (prefers-color-scheme: dark) { body { background: #16151a; color: #ede8e0; } .lost a { color: #eba286; } }
  </style>
  <div class="lost">
    <h1>You drifted off orbit.</h1>
    <p>There is nothing at this address. <a href={withBase("")}>Back to Orbit</a> or open the <a href={withBase("guide/")}>guide</a>.</p>
  </div>
</Landing>
