---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { blob, cfg } from "../../lib/source";
import { slugFor } from "../../lib/slug.mjs";
import manifest from "../../../guide.manifest.mjs";

const sections = [...manifest].sort((a, b) => a.order - b.order);
const items = sections.flatMap((section) => section.items.map((item) => ({ ...item, section: section.section, sectionSlug: section.slug })));
type Item = (typeof items)[number];
type Section = (typeof sections)[number];
interface Props { entry?: CollectionEntry<"guide">; item?: Item; section?: Section; index?: boolean }

export async function getStaticPaths() {
  const orderedSections = [...manifest].sort((a, b) => a.order - b.order);
  const guideItems = orderedSections.flatMap((section) => section.items.map((item) => ({ ...item, section: section.section, sectionSlug: section.slug })));
  const entries = await getCollection("guide");
  const byId = new Map(entries.map((entry) => [entry.id, entry]));
  const paths: { params: { slug: string | undefined }; props: Props }[] = guideItems.flatMap((item) => {
    const entry = byId.get(slugFor(item.id));
    return entry ? [{ params: { slug: item.slug ?? slugFor(item.id) }, props: { entry, item } }] : [];
  });
  paths.push(...orderedSections.map((section) => ({ params: { slug: `sections/${section.slug}` }, props: { section } })));
  paths.push({ params: { slug: undefined }, props: { index: true } });
  return paths;
}

const { entry, item, section, index = false } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const titleOf = (candidate: Item) => candidate.title ?? candidate.id;
const title = item ? titleOf(item) : section?.section ?? "Guide";
const description = item?.summary ?? (section ? `${section.section} pages in the Orbit guide.` : "Choose a path through the Orbit guide.");
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const sourcePath = entry?.filePath?.replace(/^\.\.\//, "") ?? "";
const currentIndex = item ? items.findIndex((candidate) => candidate.id === item.id) : -1;
const previous = currentIndex > 0 ? items[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? items[currentIndex + 1] : undefined;
const href = (path: string) => `${base}/guide/${path}`;
const itemHref = (candidate: Item) => href(candidate.slug ?? slugFor(candidate.id));
---

<Base title={`${title}, ${cfg.name} guide`} description={description} active="guide">
  {entry && <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />}
  <div class="guide">
    <aside class="guide__nav" aria-label="Guide sections">
      {entry && <div id="search" class="guide__search" data-pagefind-ignore></div>}
      {entry && <noscript><p>Search needs JavaScript. All documents are available below.</p></noscript>}
      <nav aria-label="Guide curriculum">
        {sections.map((group) => (
          <details class="guide__section" open={group.items.some((candidate) => candidate.id === item?.id)}>
            <summary>{group.section}</summary>
            <ul>
              {group.items.map((candidate) => {
                const navItem = { ...candidate, section: group.section, sectionSlug: group.slug };
                return <li><a href={itemHref(navItem)} aria-current={candidate.id === item?.id ? "page" : undefined}>{titleOf(navItem)}</a></li>;
              })}
              <li><a class="section__link" href={href(`sections/${group.slug}`)} aria-current={section?.slug === group.slug ? "page" : undefined}>Section overview</a></li>
            </ul>
          </details>
        ))}
      </nav>
    </aside>

    <article class="prose" data-pagefind-body>
      {entry && item?.summary && <p class="prose__summary" data-pagefind-meta="description">{item.summary}</p>}
      {entry && item && !/^\s{0,3}#\s/m.test(entry.body ?? "") && <h1>{title}</h1>}
      {entry && Content && <Content />}
      {index && <>
        <p class="eyebrow">Orbit guide</p>
        <h1>Pick your path</h1>
        <p>Start with the basics, learn the daily tools, host your own server, or explore how Orbit is built.</p>
        <div class="path-grid">
          {sections.map((group) => <a class="path-card" href={href(`sections/${group.slug}`)}><h2>{group.section}</h2><p>{group.items[0]?.summary}</p></a>)}
        </div>
        <p><a href={itemHref(items.find((candidate) => candidate.id === "README.md")!)}>Read What Orbit is</a> or open a section above.</p>
      </>}
      {section && <>
        <p class="eyebrow">Orbit guide</p>
        <h1>{section.section}</h1>
        <p>{section.items[0]?.summary}</p>
        <ol class="section-pages">
          {section.items.map((candidate) => {
            const sectionItem = { ...candidate, section: section.section, sectionSlug: section.slug };
            return <li><a href={itemHref(sectionItem)}>{titleOf(sectionItem)}</a>{candidate.summary && <p>{candidate.summary}</p>}</li>;
          })}
        </ol>
      </>}
      {entry && <>
        <nav class="guide__pager" aria-label="Guide pages">
          {previous ? <a href={itemHref(previous)}><span>Previous</span><strong>{titleOf(previous)}</strong></a> : <span />}
          {next ? <a class="guide__pager-next" href={itemHref(next)}><span>Next</span><strong>{titleOf(next)}</strong></a> : <span />}
        </nav>
        <p class="prose__source">Source: <a href={blob(sourcePath)}>{sourcePath}</a>. <a href={`${cfg.repoUrl}/edit/${cfg.branch}/${sourcePath}`}>Edit this page</a>.</p>
      </>}
    </article>

    {entry && toc.length > 2 && <nav class="guide__toc" aria-label="On this page">
      <p class="group__name">On this page</p>
      <ul>{toc.map((heading) => <li class={`d${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
    </nav>}
  </div>

  {entry && <script is:inline define:vars={{ base }}>
    const s = document.createElement("script");
    s.src = `${base}/pagefind/pagefind-ui.js`;
    s.onload = () => new PagefindUI({ element: "#search", showSubResults: true, showImages: false });
    s.onerror = () => { document.querySelector("#search").textContent = "Search is unavailable. Browse the documents below."; };
    document.head.append(s);
  </script>}
</Base>

<style>
  .guide { display: grid; gap: 2rem; max-width: 1320px; margin: 0 auto; padding: 2rem var(--gutter) 0; }
  @media (min-width: 960px) { .guide { grid-template-columns: 260px minmax(0, 1fr); gap: 3rem; } }
  @media (min-width: 1240px) { .guide { grid-template-columns: 260px minmax(0, 1fr) 220px; } }
  .guide__nav, .guide__toc { font-size: 0.9rem; }
  @media (min-width: 960px) {
    .guide__nav, .guide__toc { position: sticky; top: 76px; align-self: start; max-height: calc(100svh - 96px); overflow-y: auto; padding-bottom: 2rem; }
  }
  .guide__toc { display: none; }
  @media (min-width: 1240px) { .guide__toc { display: block; } }
  .guide__search { margin-bottom: 1rem; }
  .guide__section { margin-top: 0.55rem; }
  .guide__section summary { cursor: pointer; font-weight: 700; padding: 0.45rem 0.6rem; border-radius: 8px; min-height: 40px; }
  .guide__section summary:hover { background: var(--muted); }
  .guide__section ul, .guide__toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .guide__section a, .guide__toc a { display: block; padding: 0.28rem 0.6rem 0.28rem 1rem; border-radius: 8px; color: var(--muted-foreground); text-decoration: none; line-height: 1.35; }
  .guide__section a:hover, .guide__toc a:hover { color: var(--foreground); background: var(--muted); }
  .guide__section a[aria-current="page"] { color: var(--primary); background: var(--primary-soft); font-weight: 500; }
  .guide__toc .d3 a { padding-left: 1.3rem; font-size: 0.85rem; }
  .prose { min-width: 0; max-width: 76ch; }
  .prose__summary { color: var(--muted-foreground); font-size: var(--step-1); line-height: 1.5; }
  .prose :global(h1) { font-size: var(--step-4); margin-bottom: 1.5rem; }
  .prose :global(h2) { font-size: var(--step-2); margin: 2.8rem 0 1rem; scroll-margin-top: 80px; }
  .prose :global(h3) { font-size: var(--step-1); margin: 2rem 0 0.75rem; scroll-margin-top: 80px; }
  .prose :global(h4) { font-size: 1.05rem; margin: 1.5rem 0 0.5rem; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote), .prose :global(pre), .prose :global(table) { margin: 0 0 1.1rem; }
  .prose :global(li + li) { margin-top: 0.3rem; }
  .prose :global(blockquote) { border-left: 1px solid var(--primary); padding: 0.2rem 0 0.2rem 1.1rem; color: var(--muted-foreground); }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 0.92rem; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--border); padding: 0.55rem 0.8rem; text-align: left; vertical-align: top; }
  .prose :global(th) { font-weight: 700; background: var(--muted); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 2.5rem 0; }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--border); }
  .eyebrow { color: var(--primary); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .path-grid { display: grid; gap: 0.8rem; }
  @media (min-width: 620px) { .path-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .path-card { display: block; padding: 1.1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); color: var(--foreground); text-decoration: none; }
  .path-card:hover { border-color: var(--primary); }
  .path-card h2 { margin: 0 0 0.5rem !important; font-size: var(--step-1) !important; }
  .path-card p, .section-pages p { margin: 0; color: var(--muted-foreground); }
  .section-pages { display: grid; gap: 1.2rem; padding-left: 1.3rem; }
  .guide__pager { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border); padding-top: 1.2rem; margin-top: 3rem; }
  .guide__pager a { display: grid; gap: 0.25rem; color: var(--foreground); text-decoration: none; }
  .guide__pager a span { color: var(--muted-foreground); font-size: 0.85rem; }
  .guide__pager-next { text-align: right; margin-left: auto; }
  .prose__source { margin-top: 1.5rem !important; padding-top: 1.25rem; border-top: 1px solid var(--border); font-size: 0.88rem; color: var(--muted-foreground); }
  :global(.pagefind-ui) { --pagefind-ui-primary: var(--primary); --pagefind-ui-text: var(--foreground); --pagefind-ui-background: var(--card); --pagefind-ui-border: var(--border); --pagefind-ui-tag: var(--muted); --pagefind-ui-border-radius: 10px; --pagefind-ui-font: var(--font-sans); --pagefind-ui-scale: 0.8; }
</style>
