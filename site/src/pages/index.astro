---
import Landing from "../layouts/Landing.astro";
import { cfg, withBase } from "../lib/source";

const shot = (n: string) => withBase(`shots/${n}`);
const clip = (n: string) => withBase(`clips/${n}`);

// Hero orbit. Each ring: [rx, ry, seconds per lap, colour, radius, delay s, [task, area] x2]
const rings = [
  [150, 62, 16, "var(--career)", 11, 0, ["Apply to two internships", "Career"], ["Update portfolio site", "Career"]],
  [215, 90, 25, "var(--college)", 12, -7, ["Send chapter 2 to supervisor", "College"], ["Book lab slot", "College"]],
  [280, 118, 35, "var(--learning)", 13, -15, ["Finish ownership chapter", "Learning"], ["Read 20 pages", "Learning"]],
  [345, 146, 50, "var(--home)", 14, -25, ["Pay rent", "Home"], ["Morning run", "Home"]],
] as const;
const path = (rx: number, ry: number) => `M ${400 - rx} 400 a ${rx} ${ry} 0 1 0 ${rx * 2} 0 a ${rx} ${ry} 0 1 0 ${-rx * 2} 0`;

// Seeded stars: the same sky on every build.
let seed = 7;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 90 }, () => ({
  x: (rnd() * 100).toFixed(2),
  y: (rnd() * 100).toFixed(2),
  s: (0.8 + rnd() ** 2 * 2.2).toFixed(1),
  d: (rnd() * 6).toFixed(1),
}));

const pillars = [
  { n: "01", t: "Everything in one place", d: "Tasks, goals, routines and roadmaps side by side, instead of three apps stitched together." },
  { n: "02", t: "Instant, because it's local", d: "Every action lands on your device first. Capture in a keystroke and keep moving." },
  { n: "03", t: "Offline on every device", d: "Each client keeps a full copy and queues changes until it can sync again." },
  { n: "04", t: "Open source, and yours", d: "AGPL-3.0, on a small Rust server and one SQLite file that you own." },
];

const streak = Array.from({ length: 30 }, (_, i) => (i === 9 ? "miss" : i > 26 ? "today" : "done"));
---

<Landing title={`${cfg.name}: ${cfg.tagline}`} description={cfg.description}>
  <Fragment slot="head">
    <meta name="theme-color" content="#05060a" />
    <meta property="og:image" content={new URL(clip("orbit-film-poster.webp"), cfg.site).href} />
    <link rel="preload" href={withBase("fonts/figtree-latin-wght-normal.woff2")} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </Fragment>

  <style is:global>
    @font-face { font-family: "Figtree"; src: url("/orbit/fonts/figtree-latin-wght-normal.woff2") format("woff2"); font-weight: 300 900; font-display: swap; }
    @font-face { font-family: "Instrument Serif"; src: url("/orbit/fonts/instrument-serif-latin-400-italic.woff2") format("woff2"); font-style: italic; font-weight: 400; font-display: swap; }
    :root {
      color-scheme: dark;
      --bg: #05060a;
      --bg-2: #0a0c10;
      --card: rgba(255, 255, 255, 0.028);
      --card-hi: rgba(255, 255, 255, 0.05);
      --line: rgba(255, 255, 255, 0.08);
      --line-hi: rgba(255, 255, 255, 0.16);
      --ink: #f3f0ea;
      --muted: #a39d93;
      --faint: #6f6a62;
      --green: #93c39b;
      --green-deep: #4f7f5b;
      --sun: #e8a87c;
      --career: #dba24c;
      --college: #79a2e0;
      --learning: #b79ad6;
      --home: #dc8ba0;
      --gutter: clamp(16px, 4vw, 48px);
      --max: 1200px;
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --serif: "Instrument Serif", ui-serif, Georgia, serif;
    }
    *, *::before, *::after { box-sizing: border-box; }
    * { margin: 0; }
    html { background: var(--bg); scroll-behavior: smooth; scroll-padding-top: 84px; overflow-x: clip; }
    body { background: var(--bg); color: var(--ink); font-family: "Figtree", system-ui, sans-serif; font-size: 1.0625rem; line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: clip; }
    img, video, svg { display: block; max-width: 100%; }
    a { color: inherit; }
    :focus-visible { outline: 2px solid var(--green); outline-offset: 3px; border-radius: 6px; }
    .skip-link:focus { background: var(--green) !important; color: #0b140c !important; }
    ::selection { background: rgba(147, 195, 155, 0.35); }
  </style>

  <div class="cosmos" aria-hidden="true">
    <div class="neb neb--a"></div>
    <div class="neb neb--b"></div>
    <div class="stars">
      {stars.map((s) => <i style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;animation-delay:-${s.d}s`}></i>)}
    </div>
  </div>

  <header class="nav" id="nav">
    <div class="nav__in">
      <a class="brand" href={withBase("/")} aria-label="Orbit home">
        <img src={withBase("favicon.svg")} width="30" height="30" alt="" />
        <span>Orbit</span>
      </a>
      <nav class="nav__links" aria-label="Sections">
        <a href="#film">Film</a>
        <a href="#features">Features</a>
        <a href="#devices">Devices</a>
        <a href="#host">Self-host</a>
        <a href={withBase("guide/")}>Guide</a>
      </nav>
      <div class="nav__cta">
        <a class="gh" href={cfg.repoUrl} aria-label="Orbit on GitHub">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" /></svg>
        </a>
        <a class="btn btn--sm" href={withBase("demo/")}>Try the demo</a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero__text">
      <p class="badge"><span class="dot"></span> Open source · Self-hosted · v0.8</p>
      <h1>Everything you plan, in <em>one orbit.</em></h1>
      <p class="lede">
        Tasks, goals, routines and roadmaps in one calm planner that runs on your own small server. Web, Linux,
        Android and a CLI, all offline-first, all syncing to one SQLite file you own.
      </p>
      <div class="cta">
        <a class="btn" href={withBase("demo/")}>Try the live demo <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#film"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg> Watch the film</a>
      </div>
      <p class="meta">No sign-up. The demo runs entirely in your browser.</p>
    </div>

    <figure class="sky" id="sky">
      <div class="sky__tilt">
        <svg viewBox="40 185 720 430" role="group" aria-label="Eight tasks orbiting a sun labelled Today, on four rings: Career, College, Learning and Home. Each task is a button that completes it.">
          <defs>
            <radialGradient id="glow"><stop offset="0" stop-color="#f3b98e" stop-opacity=".75" /><stop offset=".4" stop-color="#e8a87c" stop-opacity=".25" /><stop offset="1" stop-color="#e8a87c" stop-opacity="0" /></radialGradient>
            <radialGradient id="sunfill" cx=".38" cy=".35"><stop offset="0" stop-color="#ffe0c4" /><stop offset=".6" stop-color="#eeaf82" /><stop offset="1" stop-color="#d48a5c" /></radialGradient>
          </defs>
          <circle cx="400" cy="400" r="190" fill="url(#glow)" class="glow" />
          <g transform="rotate(-24 400 400)">
            {rings.map(([rx, ry, sec, colour, r, delay, a, b]) => (
              <>
                <ellipse cx="400" cy="400" rx={rx} ry={ry} fill="none" class="orbitline" />
                {[a, b].map(([task, area], i) => (
                  <circle
                    class="body"
                    role="button"
                    tabindex="0"
                    r={i ? r * 0.7 : r}
                    fill={colour}
                    style={`color:${colour};offset-path: path('${path(rx, ry)}'); animation-duration: ${sec}s; animation-delay: ${delay - (i ? sec / 2.3 : 0)}s`}
                    data-task={task}
                    data-area={area}
                    aria-label={`${task}, ${area}. Press to complete.`}
                  />
                ))}
              </>
            ))}
          </g>
          <circle cx="400" cy="400" r="70" fill="url(#sunfill)" class="sun" />
          <text x="400" y="409" text-anchor="middle" font-size="24" font-weight="700" fill="#2a1609" letter-spacing="-0.2">Today</text>
        </svg>
        <div class="tip" id="tip" role="tooltip" hidden></div>
      </div>
      <figcaption>
        <span class="legend">
          <span style="--c: var(--career)">Career</span>
          <span style="--c: var(--college)">College</span>
          <span style="--c: var(--learning)">Learning</span>
          <span style="--c: var(--home)">Home</span>
        </span>
        <span class="score" aria-live="polite"><b id="score">0</b> of 8 done today. Click a planet to complete it.</span>
      </figcaption>
    </figure>
  </section>

  <!-- FILM -->
  <section class="film chapter reveal" id="film" aria-labelledby="film-h">
    <div class="head head--center">
      <p class="kicker">The film</p>
      <h2 id="film-h">Seventy-six seconds <em>in orbit.</em></h2>
      <p>Quick add, Home, boards, goals, routines, roadmaps, the command palette, every device and a one-file server. Recorded in the real app with made-up data.</p>
    </div>
    <div class="player" id="player">
      <div class="player__halo" aria-hidden="true"></div>
      <video
        id="filmvideo"
        poster={clip("orbit-film-poster.webp")}
        width="1920"
        height="1080"
        muted
        loop
        playsinline
        preload="none"
        aria-label="A 76 second film of Orbit: quick add, Home, project boards, goals, routines, roadmaps, the command palette and theme switch, phones, and self-hosting with Docker Compose."
      >
        <source src={clip("orbit-film.webm")} type='video/webm; codecs="av01.0.08M.08"' />
        <source src={clip("orbit-film.mp4")} type="video/mp4" />
      </video>
      <button class="play" type="button" id="playbtn" aria-label="Play the film">
        <span><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
      </button>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="pillars reveal" aria-label="What Orbit stands for">
    {pillars.map((p) => (
      <div class="pillar">
        <span class="pillar__n">{p.n}</span>
        <h3>{p.t}</h3>
        <p>{p.d}</p>
      </div>
    ))}
  </section>

  <!-- FEATURES -->
  <section class="features chapter" id="features" aria-labelledby="features-h">
    <div class="head reveal">
      <p class="kicker">Features</p>
      <h2 id="features-h">Tasks, goals and routines are <em>different things.</em></h2>
      <p>So Orbit gives each one its own shape, then keeps them all in the same place.</p>
    </div>

    <div class="bento">
      <article class="card card--qa reveal" id="quick-add">
        <div class="card__text">
          <p class="kicker">Quick add</p>
          <h3>Type it the way you <em>say it.</em></h3>
          <p>Dates, times, priority and where it lives are read straight from the sentence, in the app, the widgets, the hotkey and the CLI. Try it:</p>
        </div>
        <div class="composer">
          <label for="qa-input" class="sr">Quick add a task</label>
          <div class="composer__row">
            <span class="plus" aria-hidden="true">+</span>
            <input id="qa-input" type="text" value="Renew passport friday 10am p1 @Home" autocomplete="off" spellcheck="false" />
            <span class="enter" aria-hidden="true">↵</span>
          </div>
          <div class="chips" id="qa-chips" aria-live="polite"></div>
          <p class="qa-title" id="qa-title"></p>
          <ul class="added" id="qa-list" aria-label="Tasks you added"></ul>
          <p class="hint">Try <code>tomorrow morning</code>, <code>next fri</code>, <code>in 2 hours</code>, <code>p2</code>, <code>#errand</code>, <code>$goal</code>. A small stand-in; the real parser reads far more.</p>
        </div>
      </article>

      <article class="card card--home reveal">
        <div class="card__text">
          <p class="kicker">Home</p>
          <h3>Today, <em>at a glance.</em></h3>
          <p>What's due, what slipped, which routines you still owe and how far each goal has come.</p>
        </div>
        <div class="shot shot--tall"><img src={shot("home.webp")} width="1400" height="1305" loading="lazy" alt="Orbit Home: life at a glance, what's next, routines, upcoming tasks and goal progress." /></div>
      </article>

      <article class="card card--rout reveal">
        <div class="card__text">
          <p class="kicker">Routines</p>
          <h3>Streaks, not <em>overdue piles.</em></h3>
          <p>Habits are daily check-ins, kept apart from tasks, so a missed day never becomes a backlog.</p>
        </div>
        <div class="streak" aria-hidden="true">
          <div class="streak__head"><span>📚 Read 20 pages</span><b>Streak 30 🔥</b></div>
          <div class="streak__dots">{streak.map((s, i) => <i class={s} style={`--i:${i}`}></i>)}</div>
        </div>
        <div class="shot"><img src={shot("routines.webp")} width="1630" height="960" loading="lazy" alt="Orbit Routines: four habits with streaks, best runs, completion rates and a dot per day." /></div>
      </article>

      <article class="card card--goals reveal">
        <div class="card__text">
          <p class="kicker">Goals</p>
          <h3>A goal has a <em>finish line.</em></h3>
          <p>Milestones, a target date and progress that rolls up from sub-goals.</p>
        </div>
        <div class="shot"><img src={shot("goals.webp")} width="1400" height="1014" loading="lazy" alt="Orbit Goals: Land a summer internship and Submit the thesis, each with milestones and a progress bar." /></div>
      </article>

      <article class="card card--road reveal">
        <div class="card__text">
          <p class="kicker">Roadmaps</p>
          <h3>Plan the long game <em>in phases.</em></h3>
          <p>Ordered phases gather goals, projects and tasks over any span of time, without moving them.</p>
        </div>
        <div class="shot"><img src={shot("roadmap.webp")} width="1630" height="620" loading="lazy" alt="An Orbit roadmap timeline: Foundations, Applications, Interviews and Offer phases with milestones and a today line." /></div>
      </article>

      <article class="card card--board reveal">
        <div class="card__text">
          <p class="kicker">Projects</p>
          <h3>Lists, boards <em>and tables.</em></h3>
          <p>Switch any project's view in one click, with its pages and notes beside the tasks.</p>
        </div>
        <div class="shot"><img src={shot("board.webp")} width="1400" height="824" loading="lazy" alt="The Internship hunt project as a board with To apply and Applied columns." /></div>
      </article>

      <article class="card card--pal reveal">
        <div class="card__text">
          <p class="kicker">Command palette</p>
          <h3>Everything is a <em>keystroke away.</em></h3>
          <p>Search, jump anywhere and run commands from one palette. <kbd>Ctrl</kbd> <kbd>K</kbd></p>
        </div>
        <div class="shot"><img src={shot("palette.webp")} width="1340" height="640" loading="lazy" alt="Orbit's command palette with Toggle theme and Go to commands." /></div>
      </article>

      <article class="card card--cal reveal">
        <div class="card__text">
          <p class="kicker">Calendar</p>
          <h3>Your month, <em>in one view.</em></h3>
          <p>Tasks, milestones and routines laid out by day, with month, week and day views.</p>
        </div>
        <div class="shot"><img src={shot("calendar.webp")} width="1400" height="1176" loading="lazy" alt="Orbit's month calendar for November 2026 filled with routines, tasks and milestones." /></div>
      </article>
    </div>
  </section>

  <!-- DEVICES -->
  <section class="devices chapter" id="devices" aria-labelledby="devices-h">
    <div class="devices__text reveal">
      <p class="kicker">Every device</p>
      <h2 id="devices-h">One planner, everywhere, <em>offline too.</em></h2>
      <p>Each client keeps a local copy and queues changes while you're offline. When the connection returns they sync to your server, and the same change never applies twice.</p>
      <ul class="platforms">
        <li><b>Web</b><span>Installable as a PWA on desktop and phone.</span></li>
        <li><b>Linux</b><span>AppImage with tray, quick-capture hotkey and reminders.</span></li>
        <li><b>Android</b><span>Android 12+ APK with widgets, a share target and reminders. Smoke-tested on an emulator and one real phone; wider testing is pending.</span></li>
        <li><b>CLI</b><span><code>orbit</code> signs in, keeps a replica and queues changes. Prebuilt for Linux x86_64 and aarch64.</span></li>
      </ul>
      <p class="cta"><a class="btn btn--ghost" href={`${cfg.repoUrl}/releases/latest`}>Get the apps</a></p>
    </div>
    <div class="phones reveal" aria-label="Orbit on a phone">
      <div class="phone phone--l"><img src={shot("phone-upcoming.webp")} width="600" height="1299" loading="lazy" alt="Orbit Upcoming on a phone." /></div>
      <div class="phone phone--c"><img src={shot("phone-home.webp")} width="600" height="1299" loading="lazy" alt="Orbit Home on a phone: stats, what's next and routines, with a bottom tab bar." /></div>
      <div class="phone phone--r"><img src={shot("phone-routines.webp")} width="600" height="1299" loading="lazy" alt="Orbit Routines on a phone with streak dots." /></div>
    </div>
  </section>

  <!-- SYNC -->
  <section class="sync chapter reveal" id="sync" aria-labelledby="sync-h">
    <div class="sync__art" aria-hidden="true">
      <svg viewBox="0 0 400 400">
        <defs><radialGradient id="core"><stop offset="0" stop-color="#93c39b" stop-opacity=".55" /><stop offset="1" stop-color="#93c39b" stop-opacity="0" /></radialGradient></defs>
        <circle cx="200" cy="200" r="150" fill="url(#core)" />
        <ellipse cx="200" cy="200" rx="160" ry="160" class="sync__ring" />
        <ellipse cx="200" cy="200" rx="105" ry="105" class="sync__ring" />
        <g class="sync__spin">
          <g transform="translate(360 200)"><g class="sync__dev"><circle r="22" class="dev" /><text y="5">Web</text></g></g>
          <g transform="translate(40 200)"><g class="sync__dev"><circle r="22" class="dev" /><text y="5">CLI</text></g></g>
          <g transform="translate(200 40)"><g class="sync__dev"><circle r="22" class="dev" /><text y="5">Linux</text></g></g>
          <g transform="translate(200 360)"><g class="sync__dev"><circle r="22" class="dev" /><text y="5">Phone</text></g></g>
        </g>
        <rect x="160" y="168" width="80" height="64" rx="14" class="srv" />
        <text x="200" y="196" class="srv__t">server</text>
        <text x="200" y="214" class="srv__s">SQLite</text>
      </svg>
    </div>
    <div class="sync__text">
      <p class="kicker">Local-first sync</p>
      <h2 id="sync-h">Fast because it happens <em>here first.</em></h2>
      <ul class="facts">
        <li><b>Idempotent command queue.</b> Every change is a command with an id. Resend it as often as you like; it applies once.</li>
        <li><b>Sync tokens.</b> Clients pull only what changed since they last looked.</li>
        <li><b>Per-field last-writer-wins.</b> Rename a task on your phone and reschedule it on your laptop; both edits survive.</li>
      </ul>
      <p><a class="link" href={withBase("guide/")}>Read how it works <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- HOST -->
  <section class="host chapter" id="host" aria-labelledby="host-h">
    <div class="host__text reveal">
      <p class="kicker">Self-host</p>
      <h2 id="host-h">Your server. <em>Your SQLite file.</em></h2>
      <p>The server is a single Rust binary with one SQLite database and a daily snapshot. Run it with one Compose file, read the setup code from its log and create your account. Put it behind HTTPS before you expose it; the guide covers Tailscale and Caddy.</p>
      <p class="cta"><a class="btn" href={withBase("guide/deploy")}>Read the deploy guide</a></p>
    </div>
    <div class="term reveal" role="group" aria-label="Terminal: start the server and read the setup code">
      <div class="term__bar" aria-hidden="true"><i></i><i></i><i></i><span>~/orbit</span></div>
      <pre><code><span class="c"># no checkout needed</span>
<span class="p">$</span> curl -fsSLO https://raw.githubusercontent.com/moneytosms/orbit/main/deploy/compose.yaml
<span class="p">$</span> docker compose up -d
<span class="o">✔ Container orbit  Started</span>
<span class="p">$</span> docker compose logs orbit | grep "setup code"
<span class="o">First run: open the app and enter setup code &lt;code&gt;</span></code></pre>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final reveal" aria-labelledby="final-h">
    <div class="final__rings" aria-hidden="true"><i></i><i></i><i></i></div>
    <img class="final__logo" src={withBase("favicon.svg")} width="84" height="84" alt="" />
    <h2 id="final-h">Plan everything. <em>Own all of it.</em></h2>
    <p>Try it in your browser in seconds, then run it on your own server when you're ready.</p>
    <div class="cta cta--center">
      <a class="btn" href={withBase("demo/")}>Try the live demo <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={cfg.repoUrl}>Star on GitHub</a>
    </div>
  </section>

  <footer class="foot">
    <div class="foot__brand"><img src={withBase("favicon.svg")} width="22" height="22" alt="" /> Orbit</div>
    <p>{cfg.footnote}</p>
    <p class="foot__links">
      <a href={withBase("guide/")}>Guide</a>
      <a href={cfg.repoUrl}>Source</a>
      <a href={`${cfg.repoUrl}/releases`}>Releases</a>
    </p>
  </footer>

  <script>
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
    const root = document.documentElement;

    // Nav: solid glass once the page scrolls.
    const nav = $<HTMLElement>("#nav")!;
    const onScroll = () => nav.classList.toggle("scrolled", scrollY > 12);
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // Reveal on scroll. Content is visible without JS or with reduced motion.
    if (!reduce && "IntersectionObserver" in window) {
      root.classList.add("anim");
