---
import Landing from "../layouts/Landing.astro";
import { cfg, withBase } from "../lib/source";

const shot = (n: string) => withBase(`shots/${n}`);
// Orbit rings: [rx, ry, seconds per lap, dot colour var, dot radius, phase delay s]
const rings = [
  [150, 62, 14, "var(--career)", 11, 0],
  [215, 90, 22, "var(--college)", 12, -6],
  [280, 118, 31, "var(--learning)", 13, -13],
  [345, 146, 44, "var(--home)", 14, -22],
] as const;
const path = (rx: number, ry: number) => `M ${400 - rx} 400 a ${rx} ${ry} 0 1 0 ${rx * 2} 0 a ${rx} ${ry} 0 1 0 ${-rx * 2} 0`;
---

<Landing title={`${cfg.name}: ${cfg.tagline}`} description={cfg.description}>
  <style is:global>
    @font-face {
      font-family: "Figtree";
      src: url("/orbit/fonts/figtree-latin-wght-normal.woff2") format("woff2");
      font-weight: 300 900;
      font-display: swap;
    }
    :root {
      color-scheme: light dark;
      --paper: light-dark(#fbfaf8, #16151a);
      --side: light-dark(#f5f3ef, #1d1c22);
      --surface: light-dark(#ffffff, #23222a);
      --ink: light-dark(#2a2723, #ede8e0);
      --muted: light-dark(#6b665e, #aaa59c);
      --line: light-dark(#ebe7e0, #35333d);
      --line-strong: light-dark(#dcd5ca, #4a4753);
      --accent: #c2552f;
      --accent-text: light-dark(#a3441f, #eba286);
      --accent-soft: light-dark(#f8ebe4, #3a281f);
      --career: light-dark(#b37419, #dba24c);
      --college: light-dark(#3b6cb0, #79a2e0);
      --learning: light-dark(#468253, #82bb8d);
      --home: light-dark(#ad4f66, #dc8ba0);
      --shadow: light-dark(0 1px 2px #3c2d1914, 0 1px 2px #00000080) , light-dark(0 24px 48px -24px #3c2d1940, 0 24px 48px -24px #000000b0);
      --gutter: clamp(20px, 5vw, 64px);
    }
    :root[data-theme="light"] { color-scheme: light; }
    :root[data-theme="dark"] { color-scheme: dark; }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1.0625rem/1.6 "Figtree", system-ui, sans-serif; overflow-x: hidden; }
    a { color: var(--accent-text); text-underline-offset: 3px; text-decoration-thickness: 1px; }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
    h1, h2, h3, p { margin: 0; }
    img { display: block; max-width: 100%; height: auto; }
    code, pre { font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; }
  </style>

  <header class="mast">
    <a class="brand" href={withBase("")} aria-label="Orbit home">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#c2552f" />
        <ellipse cx="16" cy="16" rx="10.6" ry="4.6" transform="rotate(-28 16 16)" fill="none" stroke="#fbfaf8" stroke-width="1.45" />
        <circle cx="16" cy="16" r="3.9" fill="#fbfaf8" />
        <circle cx="20.2" cy="9.7" r="2.3" fill="#fbfaf8" stroke="#c2552f" stroke-width="1.4" />
      </svg>
      Orbit
    </a>
    <nav aria-label="Sections">
      <a href="#today"><span aria-hidden="true">01</span> Today</a>
      <a href="#devices"><span aria-hidden="true">02</span> Devices</a>
      <a href="#host"><span aria-hidden="true">03</span> Host it</a>
      <a href={withBase("guide/")}>Guide</a>
    </nav>
  </header>

  <section class="hero">
    <div class="hero__text">
      <p class="kicker">Self-hosted planner, open source</p>
      <h1>Everything you plan circles <em>today</em>.</h1>
      <p class="lede">
        Orbit keeps tasks, goals and routines in one calm place, on a small server you run yourself. Your data is one
        SQLite file. The web app, a Linux app, an Android app and a CLI all sync to it, and each keeps an offline copy.
      </p>
      <p class="cta">
        <a class="btn" href={withBase("guide/")}>Set up your server</a>
        <a class="btn btn--ghost" href={`${cfg.repoUrl}/releases/latest`}>Get the apps</a>
      </p>
    </div>

    <figure class="sky">
      <svg viewBox="40 185 720 430" role="img" aria-label="Four orbits around a sun labelled Today, one each for Career, College, Learning and Home, each carrying tasks.">
        <g transform="rotate(-24 400 400)">
          {rings.map(([rx, ry, sec, colour, r, delay]) => (
            <>
              <ellipse cx="400" cy="400" rx={rx} ry={ry} fill="none" stroke="var(--line-strong)" stroke-width="2" stroke-dasharray="3 8" />
              <circle class="body" r={r} fill={colour} style={`offset-path: path('${path(rx, ry)}'); animation-duration: ${sec}s; animation-delay: ${delay}s`} />
              <circle class="body" r={r * 0.55} fill={colour} opacity="0.55" style={`offset-path: path('${path(rx, ry)}'); animation-duration: ${sec}s; animation-delay: ${delay - sec / 2.6}s`} />
            </>
          ))}
        </g>
        <circle cx="400" cy="400" r="70" fill="var(--accent)" />
        <text x="400" y="410" text-anchor="middle" font-size="26" font-weight="700" fill="#fff" letter-spacing="-0.2">Today</text>
      </svg>
      <figcaption>
        <span style="--c: var(--career)">Career</span>
        <span style="--c: var(--college)">College</span>
        <span style="--c: var(--learning)">Learning</span>
        <span style="--c: var(--home)">Home</span>
      </figcaption>
    </figure>
  </section>

  <section id="today" class="today">
    <div class="today__head">
      <p class="kicker">01 / Today</p>
      <h2>Open it, and see what matters now.</h2>
      <p>
        Home shows what is due, what is overdue, how far each goal has come and which routine you still owe today.
        Type a task the way you would say it and Orbit reads the date, priority and place out of the sentence.
      </p>
    </div>
    <div class="window">
      <div class="window__bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <img src={shot("home-desktop.webp")} width="1440" height="900" alt="Orbit Home on desktop: what is due, routines, upcoming tasks and goal progress, with Areas Career, College, Learning and Home in the sidebar." />
    </div>
  </section>

  <section class="kept">
    <div class="kept__shots">
      <div class="window window--small">
        <img src={shot("routines-desktop.webp")} width="1440" height="900" alt="Orbit Routines screen with check-ins and streaks." />
      </div>
      <div class="window window--small window--offset">
        <img src={shot("goals-desktop.webp")} width="1440" height="900" alt="Orbit Goals screen with milestones and progress bars." />
      </div>
    </div>
    <div class="kept__text">
      <h2>Goals and routines are not tasks.</h2>
      <p>
        A goal has milestones and a target date. A routine has check-ins and a streak. Orbit keeps both apart from
        recurring tasks, so a habit never turns into a pile of overdue to-dos.
      </p>
      <p>
        Tasks nest under Projects and Areas, take subtasks, labels, priorities and recurrence, and import from Todoist
        with <code>orbit import todoist</code>.
      </p>
    </div>
  </section>

  <section id="devices" class="devices">
    <div class="devices__text">
      <p class="kicker">02 / Devices</p>
      <h2>One planner, every device, offline too.</h2>
      <p>
        Each client keeps a local copy and queues changes while you are offline. When the connection returns they
        sync to your server, and the same change never applies twice.
      </p>
      <ul class="stops">
        <li><b>Web</b> <span>Installable as a PWA on desktop and phone.</span></li>
        <li><b>Linux</b> <span>AppImage with tray, quick-capture hotkey and reminders. AUR package prepared.</span></li>
        <li><b>Android</b> <span>Android 12+, sideloaded APK with widgets, a share target and reminders. Verified on an emulator only; real-device testing is pending.</span></li>
        <li><b>CLI</b> <span><code>orbit</code> signs in, keeps a replica and queues changes. It builds from source today; prebuilt binaries are not released yet.</span></li>
      </ul>
    </div>
    <div class="phone">
      <img src={shot("home-phone.webp")} width="585" height="1266" alt="Orbit Home on a phone: stats, what's next and routines, with a bottom tab bar." />
    </div>
  </section>

  <section id="host" class="host">
    <div class="host__text">
      <p class="kicker">03 / Host it</p>
      <h2>Your server, your SQLite file.</h2>
      <p>
        The server is a single Rust binary with one SQLite database and a daily snapshot. Run it with Docker Compose,
        read the setup code from its log and create your account. Put it behind HTTPS before you expose it; the guide
        covers Tailscale and Caddy.
      </p>
      <p><a class="btn" href={withBase("guide/deploy")}>Read the deploy guide</a></p>
    </div>
    <pre class="term" aria-label="Terminal: start the server and read the setup code"><code><span class="c"># no checkout needed</span>
<span class="p">$</span> curl -fsSLO https://raw.githubusercontent.com/moneytosms/orbit/main/deploy/compose.yaml
<span class="p">$</span> docker compose up -d
<span class="p">$</span> docker compose logs orbit | grep "setup code"
<span class="o">First run: open the app and enter setup code &lt;code&gt;</span></code></pre>
  </section>

  <footer class="foot">
    <p>{cfg.footnote}</p>
    <p class="foot__links">
      <a href={withBase("guide/")}>Guide</a>
      <a href={cfg.repoUrl}>Source on GitHub</a>
      <a href={`${cfg.repoUrl}/releases`}>Releases</a>
    </p>
  </footer>
</Landing>

<style is:global>
  main { display: block; }
  .mast { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 20px var(--gutter); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.2rem; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .mast nav { display: flex; flex-wrap: wrap; gap: 4px 6px; }
  .mast nav a { padding: 10px 12px; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; border-radius: 8px; }
  .mast nav a span { font-size: 0.75rem; color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .mast nav a:hover { color: var(--ink); background: var(--side); }

  .kicker { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 14px; }
  h1 { font-size: clamp(2.5rem, 1.2rem + 5.4vw, 5rem); line-height: 1.04; letter-spacing: -0.03em; font-weight: 700; text-wrap: balance; }
  h1 em { font-style: normal; color: var(--accent-text); }
  h2 { font-size: clamp(1.7rem, 1.1rem + 2.2vw, 2.6rem); line-height: 1.12; letter-spacing: -0.02em; font-weight: 700; text-wrap: balance; margin-bottom: 18px; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 52ch; margin-top: 22px; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 10px; background: var(--accent); color: #fff; font-weight: 600; text-decoration: none; border: 1px solid var(--accent); }
  .btn:hover { filter: brightness(1.08); }
  .btn--ghost { background: transparent; color: var(--ink); border-color: var(--line-strong); }
  .btn--ghost:hover { background: var(--side); filter: none; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 24px var(--gutter) 72px; align-items: center; }
  .sky { margin: 0; }
  .sky svg { width: 100%; height: auto; max-width: 720px; display: block; margin: 0 auto; overflow: visible; }
  .sky figcaption { display: flex; flex-wrap: wrap; gap: 6px 18px; justify-content: center; font-size: 0.9rem; color: var(--muted); }
  .sky figcaption span::before { content: ""; display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--c); margin-right: 8px; }
  .body { offset-rotate: 0deg; animation: lap linear infinite; }
  @keyframes lap { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @media (prefers-reduced-motion: reduce) { .body { animation: none; } html { scroll-behavior: auto; } }
  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px; padding-top: 40px; padding-bottom: 104px; }
    .sky svg { max-width: none; }
  }

  .today, .kept, .devices, .host { padding: 56px var(--gutter); }
  .today__head { max-width: 62ch; margin-bottom: 40px; }
  .today__head p:last-child, .kept__text p, .devices__text > p, .host__text p { color: var(--muted); }
  .window { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--surface); box-shadow: var(--shadow); }
  .window__bar { display: flex; gap: 6px; padding: 11px 14px; background: var(--side); border-bottom: 1px solid var(--line); }
  .window__bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .window img { width: 100%; }

  .window--small { aspect-ratio: 4 / 3; }
  .window--small img { width: 180%; max-width: none; margin-left: -54%; }
  .kept { display: grid; gap: 40px; align-items: center; background: var(--side); border-block: 1px solid var(--line); }
  .kept__shots { display: grid; gap: 16px; }
  .kept__text { max-width: 52ch; }
  .kept__text p + p { margin-top: 14px; }
  @media (min-width: 960px) {
    .kept { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; }
    .kept__shots { grid-template-columns: 1fr 1fr; gap: 0; position: relative; }
    .window--offset { margin: 56px 0 0 -40px; }
    .kept__shots .window { box-shadow: var(--shadow); }
  }

  .devices { display: grid; gap: 48px; align-items: center; }
  .stops { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .stops li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .stops b { font-weight: 700; }
  .stops span { color: var(--muted); }
  .stops code, .kept code { background: var(--side); border: 1px solid var(--line); padding: 1px 6px; border-radius: 6px; font-size: 0.9em; color: var(--ink); }
  .phone { max-width: 300px; margin: 0 auto; border: 8px solid var(--ink); border-radius: 36px; overflow: hidden; background: var(--paper); box-shadow: var(--shadow); }
  @media (min-width: 960px) {
    .devices { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 96px; }
    .phone { margin: 0 auto 0 0; }
  }

  .host { display: grid; gap: 32px; align-items: center; }
  .host__text { max-width: 56ch; }
  .host__text p + p { margin-top: 22px; }
  .term { margin: 0; padding: 22px 24px; background: #1e1c19; color: #ede8e0; border-radius: 14px; font-size: 0.92rem; line-height: 1.75; overflow-x: auto; box-shadow: var(--shadow); }
  .term .c { color: #8f897f; }
  .term .p { color: #e2835e; margin-right: 8px; }
  .term .o { color: #82bb8d; }
  @media (min-width: 960px) { .host { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 72px; } }

  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; padding: 40px var(--gutter) 56px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem; }
  .foot p { max-width: 62ch; }
  .foot__links { display: flex; gap: 20px; }
  .foot__links a { padding: 10px 0; }
</style>
