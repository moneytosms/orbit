---
import Landing from "../layouts/Landing.astro";
import { cfg, withBase } from "../lib/source";

const shot = (n: string) => withBase(`shots/${n}`);
const clip = (n: string) => withBase(`clips/${n}`);

// Each ring: [rx, ry, seconds per lap, colour, radius, delay s, [task, area] x2]
const rings = [
  [150, 62, 16, "var(--career)", 11, 0, ["Apply to two internships", "Career"], ["Update portfolio site", "Career"]],
  [215, 90, 25, "var(--college)", 12, -7, ["Send chapter 2 to supervisor", "College"], ["Book lab slot", "College"]],
  [280, 118, 35, "var(--learning)", 13, -15, ["Finish ownership chapter", "Learning"], ["Read 20 pages", "Learning"]],
  [345, 146, 50, "var(--home)", 14, -25, ["Pay rent", "Home"], ["Morning run", "Home"]],
] as const;
const path = (rx: number, ry: number) => `M ${400 - rx} 400 a ${rx} ${ry} 0 1 0 ${rx * 2} 0 a ${rx} ${ry} 0 1 0 ${-rx * 2} 0`;

// Seeded stars: same sky on every build.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: 64 }, () => ({
  x: (rnd() * 100).toFixed(1),
  y: (rnd() * 100).toFixed(1),
  s: (1 + rnd() * 2.2).toFixed(1),
  d: (rnd() * 6).toFixed(1),
  z: (0.3 + rnd() * 1.2).toFixed(2),
}));

const tabs = [
  { id: "home", label: "Home", img: "home-desktop.webp", alt: "Orbit Home: what is due, routines, upcoming tasks and goal progress.", text: "Home gathers what is due, what slipped, how far each goal has come and which routine you still owe today." },
  { id: "goals", label: "Goals", img: "goals-desktop.webp", alt: "Orbit Goals with milestones and progress bars.", text: "Goals have milestones and a target date, and roll their progress up from sub-goals." },
  { id: "routines", label: "Routines", img: "routines-desktop.webp", alt: "Orbit Routines with check-ins and streaks.", text: "Routines have check-ins and a streak, kept apart from recurring tasks so a habit never becomes a pile of overdue to-dos." },
];
---

<Landing title={`${cfg.name}: ${cfg.tagline}`} description={cfg.description}>
  <script is:inline slot="head">
    // Saved choice wins; otherwise follow the OS. Same key as the guide, so the two stay in step.
    try {
      const t = localStorage.getItem("site-theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    } catch {}
    document.documentElement.classList.add("js");
  </script>

  <style is:global>
    @font-face {
      font-family: "Figtree";
      src: url("/orbit/fonts/figtree-latin-wght-normal.woff2") format("woff2");
      font-weight: 300 900;
      font-display: swap;
    }
    :root {
      color-scheme: light dark;
      --paper: light-dark(#fbfaf8, #1b1a18);
      --side: light-dark(#f5f3ef, #211f1d);
      --surface: light-dark(#ffffff, #252321);
      --sunk: light-dark(#f2efea, #1e1d1b);
      --ink: light-dark(#2a2723, #ede8e0);
      --muted: light-dark(#6b665e, #a8a197);
      --line: light-dark(#ebe7e0, #33302c);
      --line-strong: light-dark(#dcd5ca, #45413b);
      --accent: light-dark(#4f7f5b, #93c39b);
      --accent-ink: light-dark(#ffffff, #0b140c);
      --accent-text: light-dark(#3f6b4a, #a8d2af);
      --accent-soft: light-dark(#e4efe5, #1f2d22);
      --accent-line: light-dark(#b9d3bd, #3e5b45);
      --sun: #e8a87c;
      --sun-glow: light-dark(#e8a87c55, #e8a87c33);
      --career: light-dark(#b37419, #dba24c);
      --college: light-dark(#3b6cb0, #79a2e0);
      --learning: light-dark(#7e5a9b, #b79ad6);
      --home: light-dark(#ad4f66, #dc8ba0);
      --shadow: 0 1px 2px light-dark(#3c2d1914, #00000080), 0 28px 56px -28px light-dark(#3c2d1944, #000000c0);
      --gutter: clamp(20px, 5vw, 72px);
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }
    :root[data-theme="light"] { color-scheme: light; }
    :root[data-theme="dark"] { color-scheme: dark; }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1.0625rem/1.6 "Figtree", system-ui, sans-serif; overflow-x: hidden; transition: background-color .3s, color .3s; }
    a { color: var(--accent-text); text-underline-offset: 3px; text-decoration-thickness: 1px; }
    a:focus-visible, button:focus-visible, input:focus-visible, [role="button"]:focus-visible, [role="tab"]:focus-visible, video:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
    h1, h2, h3, p { margin: 0; }
    img, video { display: block; max-width: 100%; height: auto; }
    code, pre { font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; }
    ::selection { background: var(--accent-soft); color: var(--ink); }
  </style>

  <header class="mast">
    <a class="brand" href={withBase("")} aria-label="Orbit home">
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#4f7f5b" />
        <ellipse cx="16" cy="16" rx="10.6" ry="4.6" transform="rotate(-28 16 16)" fill="none" stroke="#fbfaf8" stroke-width="1.45" />
        <circle cx="16" cy="16" r="3.9" fill="#e8a87c" />
        <circle cx="20.2" cy="9.7" r="2.3" fill="#fbfaf8" stroke="#4f7f5b" stroke-width="1.4" />
      </svg>
      Orbit
    </a>
    <nav aria-label="Sections">
      <a href="#tour">Tour</a>
      <a href="#quick-add">Quick add</a>
      <a href="#screens">Screens</a>
      <a href="#devices">Devices</a>
      <a href="#host">Host it</a>
      <a href={withBase("guide/")}>Guide</a>
      <button class="theme" type="button" data-theme-toggle aria-label="Switch colour theme">
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      </button>
    </nav>
  </header>

  <section class="hero" id="top">
    <div class="stars" aria-hidden="true">
      {stars.map((s) => <i style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;animation-delay:-${s.d}s;--z:${s.z}`}></i>)}
    </div>

    <div class="hero__text">
      <p class="kicker">Self-hosted planner, open source</p>
      <h1>Everything you plan circles <em>today</em>.</h1>
      <p class="lede">
        Orbit keeps tasks, goals and routines in one calm place, on a small server you run yourself. Your data is one
        SQLite file. The web app, a Linux app, an Android app and a CLI all sync to it, and each keeps an offline copy.
      </p>
      <p class="cta">
        <a class="btn" href={withBase("guide/deploy")}>Set up your server</a>
        <a class="btn btn--ghost" href={`${cfg.repoUrl}/releases/latest`}>Get the apps</a>
      </p>
    </div>

    <figure class="sky" id="sky">
      <div class="sky__tilt">
        <svg viewBox="40 185 720 430" role="group" aria-label="Eight tasks orbiting a sun labelled Today, on four rings: Career, College, Learning and Home. Each task is a button that completes it.">
          <defs>
            <radialGradient id="glow"><stop offset="0" stop-color="var(--sun)" stop-opacity=".55" /><stop offset="1" stop-color="var(--sun)" stop-opacity="0" /></radialGradient>
          </defs>
          <circle cx="400" cy="400" r="150" fill="url(#glow)" class="glow" />
          <g transform="rotate(-24 400 400)">
            {rings.map(([rx, ry, sec, colour, r, delay, a, b]) => (
              <>
                <ellipse cx="400" cy="400" rx={rx} ry={ry} fill="none" stroke="var(--line-strong)" stroke-width="2" stroke-dasharray="3 8" />
                {[a, b].map(([task, area], i) => (
                  <circle
                    class="body"
                    role="button"
                    tabindex="0"
                    r={i ? r * 0.7 : r}
                    fill={colour}
                    data-task={task}
                    data-area={area}
                    aria-label={`${task}, ${area}. Press to complete.`}
                    style={`offset-path: path('${path(rx, ry)}'); animation-duration: ${sec}s; animation-delay: ${delay - (i ? sec / 2.3 : 0)}s`}
                  />
                ))}
              </>
            ))}
          </g>
          <circle cx="400" cy="400" r="70" fill="var(--sun)" class="sun" />
          <text x="400" y="410" text-anchor="middle" font-size="26" font-weight="700" fill="#2a1a0e" letter-spacing="-0.2">Today</text>
        </svg>
        <div class="tip" id="tip" role="tooltip" hidden></div>
      </div>
      <figcaption>
        <span class="legend">
          <span style="--c: var(--career)">Career</span>
          <span style="--c: var(--college)">College</span>
          <span style="--c: var(--learning)">Learning</span>
          <span style="--c: var(--home)">Home</span>
        </span>
        <span class="score" aria-live="polite"><b id="score">0</b> of 8 done today. Try it: click a task.</span>
      </figcaption>
    </figure>
  </section>

  <section id="tour" class="tour reveal">
    <div class="tour__head">
      <p class="kicker">01 / Tour</p>
      <h2>Twenty seconds, start to finish.</h2>
      <p>Type a task the way you would say it, see Home, tick a routine, then the same planner on the desktop, phone and command line.</p>
    </div>
    <div class="player spot">
      <video
        id="tourvideo"
        src={clip("orbit-launch.mp4")}
        poster={clip("orbit-launch-poster.webp")}
        width="1920"
        height="1080"
        muted
        loop
        playsinline
        controls
        preload="none"
        aria-label="A 20 second tour of Orbit: quick add, Home, routines and the apps."
      ></video>
      <button class="play" type="button" id="playbtn" aria-label="Play the tour video">
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </button>
    </div>
    <p class="note">Recorded in the real app with made-up data. Sound is off by default.</p>
  </section>

  <section id="quick-add" class="qa reveal">
    <div class="qa__text">
      <p class="kicker">02 / Quick add</p>
      <h2>Type it like you would say it.</h2>
      <p>
        Dates, times, priority and where it lives are read straight out of the sentence. Try it below: change the
        text, then press Enter to add it to the list.
      </p>
      <p class="hint">Understands <code>friday</code>, <code>tomorrow</code>, <code>10am</code>, <code>p1</code>, <code>@area</code>, <code>$goal</code>, <code>%page</code>, <code>#label</code>. This is a small demo; the real parser ships in every Orbit app.</p>
    </div>
    <div class="composer spot">
      <label for="qa-input" class="sr">Quick add a task</label>
      <input id="qa-input" type="text" value="Renew passport friday 10am p1 @Home" autocomplete="off" spellcheck="false" />
      <div class="chips" id="qa-chips" aria-live="polite"></div>
      <p class="title" id="qa-title"></p>
      <ul class="added" id="qa-list" aria-label="Tasks you added"></ul>
    </div>
  </section>

  <section id="screens" class="screens reveal">
    <div class="screens__head">
      <p class="kicker">03 / Screens</p>
      <h2>Tasks, goals and routines are different things.</h2>
      <p id="tab-text">{tabs[0].text}</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Orbit screens">
      {tabs.map((t, i) => (
        <button role="tab" type="button" id={`tab-${t.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls="screen-panel" tabindex={i === 0 ? 0 : -1} data-text={t.text} data-img={t.img} data-alt={t.alt}>{t.label}</button>
      ))}
    </div>
    <div class="window spot" id="screen-panel" role="tabpanel" aria-labelledby="tab-home">
      <div class="window__bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <img id="screen-img" class="shot-light" src={shot(tabs[0].img)} width="1440" height="900" alt={tabs[0].alt} />
      <img class="shot-dark" src={shot("home-dark-desktop.webp")} width="1440" height="900" alt="Orbit Home in dark mode." />
    </div>
    <p class="note">Orbit has a full dark theme too. Flip the switch at the top to see this page in it.</p>
  </section>

  <section id="devices" class="devices reveal">
    <div class="devices__text">
      <p class="kicker">04 / Devices</p>
      <h2>One planner, every device, offline too.</h2>
      <p>
        Each client keeps a local copy and queues changes while you are offline. When the connection returns they
        sync to your server, and the same change never applies twice.
      </p>
      <ul class="stops">
        <li><b>Web</b> <span>Installable as a PWA on desktop and phone.</span></li>
        <li><b>Linux</b> <span>AppImage with tray, quick-capture hotkey and reminders. AUR package prepared.</span></li>
        <li><b>Android</b> <span>Android 12+, sideloaded APK with widgets, a share target and reminders. Verified on an emulator only; real-device testing is pending.</span></li>
        <li><b>CLI</b> <span><code>orbit</code> signs in, keeps a replica and queues changes. It builds from source today; prebuilt binaries are not released yet.</span></li>
      </ul>
    </div>
    <div class="phone spot">
      <img src={shot("home-phone.webp")} width="585" height="1266" alt="Orbit Home on a phone: stats, what's next and routines, with a bottom tab bar." />
    </div>
  </section>

  <section id="host" class="host reveal">
    <div class="host__text">
      <p class="kicker">05 / Host it</p>
      <h2>Your server, your SQLite file.</h2>
      <p>
        The server is a single Rust binary with one SQLite database and a daily snapshot. Run it with one Compose file,
        read the setup code from its log and create your account. Put it behind HTTPS before you expose it; the guide
        covers Tailscale and Caddy.
      </p>
      <p><a class="btn" href={withBase("guide/deploy")}>Read the deploy guide</a></p>
    </div>
    <pre class="term" aria-label="Terminal: start the server and read the setup code"><code><span class="c"># no checkout needed</span>
<span class="p">$</span> curl -fsSLO https://raw.githubusercontent.com/moneytosms/orbit/main/deploy/compose.yaml
<span class="p">$</span> docker compose up -d
<span class="p">$</span> docker compose logs orbit | grep "setup code"
<span class="o">First run: open the app and enter setup code &lt;code&gt;</span></code></pre>
  </section>

  <footer class="foot">
    <p>{cfg.footnote}</p>
    <p class="foot__links">
      <a href={withBase("guide/")}>Guide</a>
      <a href={cfg.repoUrl}>Source on GitHub</a>
      <a href={`${cfg.repoUrl}/releases`}>Releases</a>
    </p>
  </footer>

  <script>
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
    const root = document.documentElement;

    // Theme toggle (same key as the guide).
    $("[data-theme-toggle]")?.addEventListener("click", () => {
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      const next = dark ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("site-theme", next); } catch {}
    });

    // Reveal on scroll. Content is visible without JS or with reduced motion.
    if (!reduce && "IntersectionObserver" in window) {
      root.classList.add("anim");
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    }

    // Spotlight that follows the pointer on framed media.
    document.querySelectorAll<HTMLElement>(".spot").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${e.clientX - r.left}px`);
        el.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });

    // Hero: parallax tilt, hover tooltip, click to complete.
    const sky = $<HTMLElement>("#sky")!, hero = $<HTMLElement>(".hero")!, tip = $<HTMLElement>("#tip")!, score = $("#score")!;
    if (!reduce) {
      hero.addEventListener("pointermove", (e) => {
        const r = hero.getBoundingClientRect();
        sky.style.setProperty("--px", String(((e.clientX - r.left) / r.width - 0.5) * 2));
        sky.style.setProperty("--py", String(((e.clientY - r.top) / r.height - 0.5) * 2));
        hero.style.setProperty("--px", sky.style.getPropertyValue("--px"));
        hero.style.setProperty("--py", sky.style.getPropertyValue("--py"));
      });
      hero.addEventListener("pointerleave", () => { sky.style.setProperty("--px", "0"); sky.style.setProperty("--py", "0"); hero.style.setProperty("--px", "0"); hero.style.setProperty("--py", "0"); });
    }
    const bodies = [...document.querySelectorAll<SVGCircleElement>(".body")];
    let done = 0;
    const show = (b: SVGCircleElement) => {
      const r = b.getBoundingClientRect(), s = sky.getBoundingClientRect();
      tip.textContent = `${b.dataset.task} · ${b.dataset.area}`;
      tip.hidden = false;
      tip.style.left = `${r.left - s.left + r.width / 2}px`;
      tip.style.top = `${r.top - s.top}px`;
    };
    const complete = (b: SVGCircleElement) => {
      if (b.classList.contains("done")) return;
      b.classList.add("done");
      score.textContent = String(++done);
      tip.hidden = true;
      if (done === bodies.length) {
        $(".score")!.innerHTML = "<b id=\"score\">8</b> of 8 done. Today is clear.";
        setTimeout(() => { bodies.forEach((x) => x.classList.remove("done")); done = 0; $(".score")!.innerHTML = "<b id=\"score\">0</b> of 8 done today. Try it: click a task."; }, 3200);
      }
    };
    bodies.forEach((b) => {
      b.addEventListener("pointerenter", () => show(b));
      b.addEventListener("pointerleave", () => (tip.hidden = true));
      b.addEventListener("focus", () => show(b));
      b.addEventListener("blur", () => (tip.hidden = true));
      b.addEventListener("click", () => complete(b));
      b.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); complete(b); } });
    });

    // Video: play when in view (muted), manual play button, never autoplay under reduced motion.
    const vid = $<HTMLVideoElement>("#tourvideo"), play = $<HTMLButtonElement>("#playbtn");
    if (vid && play) {
      const sync = () => (play.hidden = !vid.paused);
      vid.addEventListener("play", sync); vid.addEventListener("pause", sync);
      play.addEventListener("click", () => vid.play());
      if (!reduce) new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? vid.play().catch(() => {}) : vid.pause())), { threshold: 0.5 }).observe(vid);
    }

    // Screens tabs (arrow keys move between tabs).
    const tabsEl = [...document.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const img = $<HTMLImageElement>("#screen-img")!, txt = $("#tab-text")!, panel = $("#screen-panel")!;
    const pick = (t: HTMLButtonElement) => {
      tabsEl.forEach((x) => { x.setAttribute("aria-selected", String(x === t)); x.tabIndex = x === t ? 0 : -1; });
      img.src = img.src.replace(/[^/]+$/, t.dataset.img!); img.alt = t.dataset.alt!; txt.textContent = t.dataset.text!;
      panel.setAttribute("aria-labelledby", t.id);
      panel.classList.toggle("is-home", t.dataset.img === "home-desktop.webp");
    };
    panel.classList.add("is-home");
    tabsEl.forEach((t, i) => {
      t.addEventListener("click", () => pick(t));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        const n = tabsEl[(i + d + tabsEl.length) % tabsEl.length]; n.focus(); pick(n);
      });
    });

    // Quick-add demo: a small stand-in for the real parser.
    const input = $<HTMLInputElement>("#qa-input")!, chips = $("#qa-chips")!, title = $("#qa-title")!, list = $("#qa-list")!;
    const days = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
    const fmt = (d: Date) => d.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" });
    function parse(text: string) {
      let rest = text; const out: { k: string; t: string; c?: string }[] = [];
      const take = (re: RegExp, f: (m: RegExpMatchArray) => void) => { const m = rest.match(re); if (m) { f(m); rest = rest.replace(m[0], " "); } };
      take(/(^|\s)p([1-4])(?=\s|$)/i, (m) => out.push({ k: "Priority", t: `P${m[2]}`, c: m[2] === "1" ? "p1" : "" }));
      let time = "";
      take(/(^|\s)(\d{1,2})(?::(\d{2}))?\s?(am|pm)(?=\s|$)/i, (m) => { let h = +m[2] % 12; if (/pm/i.test(m[4])) h += 12; time = `${String(h).padStart(2, "0")}:${m[3] ?? "00"}`; });
      let date: Date | null = null;
      take(/(^|\s)(today|tonight|tomorrow|tmrw|mon(?:day)?|tue(?:s(?:day)?)?|wed(?:nesday)?|thu(?:r(?:s(?:day)?)?)?|fri(?:day)?|sat(?:urday)?|sun(?:day)?)(?=\s|$)/i, (m) => {
        const w = m[2].toLowerCase(); const d = new Date(); d.setHours(0, 0, 0, 0);
        if (w === "tomorrow" || w === "tmrw") d.setDate(d.getDate() + 1);
        else if (w !== "today" && w !== "tonight") { const i = days.findIndex((n) => n.startsWith(w.slice(0, 3))); d.setDate(d.getDate() + (((i - d.getDay() + 6) % 7) + 1)); }
        date = d;
      });
      if (time && !date) { date = new Date(); date.setHours(0, 0, 0, 0); }
      if (date) out.unshift({ k: "Due", t: `${fmt(date)}${time ? `, ${time}` : ""}` });
      for (const [sig, k] of [["@", "Place"], ["$", "Goal"], ["%", "Page"], ["#", "Label"]] as const)
        for (const m of [...rest.matchAll(new RegExp(`(^|\\s)[${sig}]([\\p{L}\\p{N}_-]+)`, "gu"))]) out.push({ k, t: `${sig}${m[2]}` });
      rest = rest.replace(/(^|\s)[@$%#][\p{L}\p{N}_-]+/gu, " ");
      return { title: rest.replace(/\s+/g, " ").trim(), tokens: out };
    }
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const chipHtml = (o: { k: string; t: string; c?: string }) => `<span class="chip ${o.c ?? ""}"><small>${o.k}</small>${esc(o.t)}</span>`;
    function render() {
      const p = parse(input.value);
      title.textContent = p.title ? `Task: ${p.title}` : "Start typing a task.";
      chips.innerHTML = p.tokens.map(chipHtml).join("");
    }
    input.addEventListener("input", render);
    input.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const p = parse(input.value); if (!p.title) return;
      const li = document.createElement("li");
      li.innerHTML = `<span class="circle"></span><span class="t">${esc(p.title)}</span>${p.tokens.map(chipHtml).join("")}`;
      li.querySelector(".circle")!.addEventListener("click", () => li.classList.toggle("ticked"));
      list.prepend(li); while (list.children.length > 3) list.lastElementChild!.remove();
      input.value = ""; render();
    });
    render();
  </script>
</Landing>

