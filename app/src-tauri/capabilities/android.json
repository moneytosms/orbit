{
  "identifier": "android-remote",
  "windows": [
    "main"
  ],
  "platforms": [
    "android"
  ],
  "remote": {
    "urls": [
      "http://*",
      "https://*",
      "http://*:*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-set-token",
    "allow-clear-token",
    "allow-has-token",
    "allow-set-server",
    "allow-take-link",
    "allow-shell-version"
  ]
}
