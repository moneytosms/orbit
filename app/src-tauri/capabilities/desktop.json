{
  "identifier": "desktop-remote",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux"
  ],
  "remote": {
    "urls": [
      "http://*",
      "https://*",
      "http://*:*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "notification:default",
    "allow-set-token",
    "allow-clear-token",
    "allow-has-token",
    "allow-set-server",
    "allow-get-auto-updates",
    "allow-set-auto-updates",
    "allow-notify-upgrade-required",
    "allow-clear-upgrade-required"
  ]
}
