{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.6.0",
  "identifier": "dev.orbit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": { "security": { "csp": "script-src 'self' 'wasm-unsafe-eval'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }, "windows": [
    { "label": "main", "title": "Orbit", "visible": false },
    { "label": "capture", "title": "Quick capture", "url": "index.html", "width": 640, "height": 180, "center": true, "visible": false, "decorations": false, "shadow": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "focus": true }
  ] },
  "bundle": { "active": true, "createUpdaterArtifacts": true, "targets": ["deb", "appimage"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"] },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRTg4RjI2QkM5MDhFQkMKUldTOGpwQzhKby9vaTlQMXp2Z3BEZHVrSTE4Qk5UdUFORGRSby9obURIVGJTbE5WTDk4SUZjV0kK",
      "endpoints": ["https://github.com/moneytosms/orbit/releases/latest/download/latest.json"]
    }
  }
}
