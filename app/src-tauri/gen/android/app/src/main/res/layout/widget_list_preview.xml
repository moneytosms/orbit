<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of the task list widget: static sample rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_panel" android:orientation="vertical" android:padding="14dp">
