<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of the Goal widget: one card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_panel" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="2" android:text="@string/preview_goal_title" android:textColor="@color/widget_text" android:textSize="17sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="62%" android:textColor="@color/widget_accent" android:textSize="34sp" />
    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:max="100" android:progress="62" android:progressDrawable="@drawable/widget_progress" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="13/21 km" android:textColor="@color/widget_muted" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preview_goal_target" android:textColor="@color/widget_muted" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
